    "susdr_vault/SusdrRedeemer": {
      "title": "SusdrRedeemer",
      "anyOf": [
        {
          "title": "Deposit",
          "description": "Add USDr, mint sUSDr shares at the current price.",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
        {
          "title": "Withdraw",
          "description": "Burn `shares` from a position, take at most `redeem_value(shares)`.",
          "dataType": "constructor",
          "index": 1,
          "fields": [
            {
              "title": "shares",
              "$ref": "#/definitions/Int"
            }
          ]
        },
        {
          "title": "Accrue",
          "description": "Operators add `amount` of real, on-chain USDr yield; depositor share\n count untouched, but the accrued management fee is minted to the\n treasury first, so the fee is never charged on yield that has not\n actually landed.",
          "dataType": "constructor",
          "index": 2,
          "fields": [
            {
              "title": "amount",
              "$ref": "#/definitions/Int"
            }
          ]
        },
        {
          "title": "SetPaused",
          "description": "Operators halt deposits and accruals. Withdrawals stay open.",
          "dataType": "constructor",
          "index": 3,
          "fields": [
            {
              "title": "paused",
              "$ref": "#/definitions/Bool"
            }
          ]
        },
        {
          "title": "RotateCommittee",
          "description": "Operators replace the signing committee. Requires M-of-N of the\n OUTGOING committee; the incoming committee must itself be valid.\n Nothing else about the vault may move in the same transaction.",
          "dataType": "constructor",
          "index": 4,
          "fields": [
            {
              "title": "operators",
              "$ref": "#/definitions/List<ByteArray>"
            },
            {
              "title": "threshold",
              "$ref": "#/definitions/Int"
            }
          ]
        },
        {
          "title": "SetFee",
          "description": "Governance-executed fee change. Settles the fee accrued under the OLD\n rate first, then writes the new rate. Capped by `shares.max_fee_bps`.",
          "dataType": "constructor",
          "index": 5,
          "fields": [
            {
              "title": "fee_bps",
              "$ref": "#/definitions/Int"
            }
          ]
        },
        {
          "title": "ClaimFee",
          "description": "Treasury cashes out part of its accrued fee shares at the current\n price.",
          "dataType": "constructor",
          "index": 6,
          "fields": [
            {
              "title": "shares",
              "$ref": "#/definitions/Int"
            }
          ]
        }
