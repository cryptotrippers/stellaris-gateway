          "index": 4,
          "fields": [
            {
              "title": "operators",
              "$ref": "#/definitions/List$ByteArray"
            },
            {
              "title": "threshold",
              "$ref": "#/definitions/Int"
            }
          ]
        },
        {
          "title": "SetFee",
          "description": "Governance-executed fee change. Settles the fee accrued under the OLD\n rate first, then writes the new rate. Capped by `shares.max_fee_bps`.",
