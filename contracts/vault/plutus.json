        {
          "title": "State",
          "description": "The vault's aggregate ledger. Exactly one per vault.\n\n Fee fields (Stage 5): the management fee is an annual rate in basis\n points charged on accounted assets, prorated by wall-clock time and\n settled by MINTING shares to the treasury rather than paying lovelace\n out. `treasury_shares` is the treasury's unclaimed slice of\n `total_shares`; `last_fee_time` is the POSIX ms up to which fee has\n already been charged.",
          "dataType": "constructor",
          "index": 1,
          "fields": [
            {
              "title": "total_shares",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "total_assets",
              "$ref": "#/definitions/Int"
            },
