          "dataType": "constructor",
          "index": 3,
          "fields": [
            {
              "title": "paused",
              "$ref": "#/definitions/Bool"
            }
          ]
        },
        {
          "title": "RotateCommittee",
          "description": "Operators replace the signing committee. Requires M-of-N of the OUTGOING\n committee; the incoming committee must itself be valid. Nothing else\n about the vault may move in the same transaction.",
