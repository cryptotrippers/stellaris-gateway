      "anyOf": [
        {
          "title": "Deposit",
          "description": "Add lovelace, mint shares at the current price.",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
        {
          "title": "Withdraw",
          "description": "Burn `shares` from a position, take at most `redeem_value(shares)`.",
          "dataType": "constructor",
          "index": 1,
          "fields": [
            {
              "title": "shares",
              "$ref": "#/definitions/Int"
            }
          ]
        },
        {
          "title": "Accrue",
          "description": "Operators add `amount` lovelace of yield; depositor share count\n untouched, but the accrued management fee is minted to the treasury\n first, so the fee is never charged on yield that has not landed yet.",
          "dataType": "constructor",
          "index": 2,
          "fields": [
            {
              "title": "amount",
              "$ref": "#/definitions/Int"
            }
          ]
        },
        {
          "title": "SetPaused",
