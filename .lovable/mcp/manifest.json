{
  "version": 1,
  "sdk_version": "0.22.2",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "stellaris-gateway-mcp",
      "version": "0.2.0",
      "title": "Stellaris Gateway MCP"
    },
    "tools": [
      {
        "name": "list_assets",
        "title": "List marketplace assets",
        "description": "List tokenized real-world assets available in the Stellaris marketplace. Optionally filter by category or risk profile.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "Filter by asset category.",
              "type": "string",
              "enum": [
                "Sustainable Farming",
                "Clean Energy",
                "Real Estate",
                "Carbon Credits",
                "Infrastructure"
              ]
            },
            "risk": {
              "description": "Filter by risk profile.",
              "type": "string",
              "enum": [
                "Conservative",
                "Moderate",
                "Aggressive"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_asset",
        "title": "Get asset details",
        "description": "Fetch full details for a single Stellaris marketplace asset by its ID (e.g. 'sfm-01').",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "The asset ID, e.g. 'sfm-01'."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "search_assets",
        "title": "Search marketplace assets",
        "description": "Full-text search Stellaris marketplace assets by name, description, issuer, or location.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Search query."
            },
            "limit": {
              "description": "Max results (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "estimate_yield",
        "title": "Estimate yield for an asset",
        "description": "Estimate projected yield in ADA for a given Stellaris asset, investment amount, and holding period.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "assetId": {
              "type": "string",
              "minLength": 1,
              "description": "Asset ID to estimate yield for."
            },
            "amountAda": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Investment amount in ADA."
            },
            "months": {
              "description": "Holding period in months (defaults to asset maturity).",
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            }
          },
          "required": [
            "assetId",
            "amountAda"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_vault_activity",
        "title": "List vault activity (authenticated)",
        "description": "List recent vault activity — deposits, withdrawals, yield distributions, rebalances, and timelock events. Requires an MCP API key.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "apiKey": {
              "type": "string",
              "minLength": 1,
              "description": "MCP API key issued by the app operator."
            },
            "limit": {
              "description": "Max entries to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "kind": {
              "description": "Filter by activity kind.",
              "type": "string",
              "enum": [
                "Deposit",
                "Withdrawal",
                "Yield Distribution",
                "Rebalance",
                "Timelock Set"
              ]
            }
          },
          "required": [
            "apiKey"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_stewardship",
        "title": "List stewardship activity (authenticated)",
        "description": "List governance proposals under stewardship review, including voting status, quorum, and author. Requires an MCP API key.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "apiKey": {
              "type": "string",
              "minLength": 1,
              "description": "MCP API key issued by the app operator."
            },
            "status": {
              "description": "Filter by proposal status.",
              "type": "string",
              "enum": [
                "Voting",
                "Executed",
                "Defeated",
                "Queued"
              ]
            },
            "category": {
              "description": "Filter by proposal category.",
              "type": "string",
              "enum": [
                "Treasury",
                "Protocol",
                "Listing",
                "Risk"
              ]
            }
          },
          "required": [
            "apiKey"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
